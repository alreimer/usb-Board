end

< "A" 1 10
    shell "chvt ??_nvalue?? &";
    boot_cgi [ "show" 0 ];
end


< "A" 33
    switch "/?menu_name?/";
    boot_cgi [ "show" 0 ] {
	boot_cgi [ "timeout" ] {
	    boot_page "??_back??";
	}
    }
//    boot_page "??_back??";
end

cgi: "show" 0
