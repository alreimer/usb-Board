area:2000:menu_name
wr_par: menu_name:??_back??

< "show" 0
	print [ 12 > "DL" > "AL" 0 1
> "AT" 2 1 100 29 7 0 "Ctty7|X" 0
> "AT" 104 1 201 29 8 0 "Ctty8|usb-Board" 0
> "AT" 2 33 100 61 9 0 "Ctty9|Firewall|log" 0
> "AT" 104 33 201 61 10 0 "Ctty10|syslog" 0
