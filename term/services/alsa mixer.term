/*with timeout*/
area:40000:buffer
area:10:card

//set the card number for control of
wr_par: card:2

include: services_roll.incterm

/*
name
index
max level
level
on or off
*/

< "show"
	write_system ":buffer:amixer -c ??card??";
	print [
table: list
#-> parse_area: buffer
while:Simple mixer control/[/*/]\n/BS/--/\\0/E
check:/*  Playback channels: 
if: '/[/*/]'
if:,/[/<-1234567890/>/]\n
if:/*  Limits: /BPlayback /\/E0 - /[/<-1234567890/>/]\n
if:  Mono:/*/BPlayback /\/E/[/<-1234567890/>/]
if:/*[/[/Bon/\off/E/]]
#end_table ];
/*	tbl_changed "list"{
	    print [ >>>> "wait:" 10 0 ];
	    exit_cgi;
	}
*/	print [
12 > "DL" > "AL" 0 1
if "_@list+1:" > "ZL" 0 1  ">" $_@list+1#0:24 " " $_@list+1#2:24 " " $_@list+1#3:24 0 if "_@list+1#4:" > "AT" 1 10 30 30 1 0 "C" $_@list+1#4:3 0 fi if "_@list+1#2:" > "BR" 1 34 10 200 30 1 #_@list+1#2 1 1 > "BA" 1 #_@list+1#3 > "AB" 1 fi fi
if "_@list+2:" > "ZL" 0 33 ">" $_@list+2#0:24 " " $_@list+2#2:24 " " $_@list+2#3:24 0 if "_@list+2#4:" > "AT" 1 42 30 62 2 0 "C" $_@list+2#4:3 0 fi if "_@list+2#2:" > "BR" 2 34 42 200 62 1 #_@list+2#2 1 1 > "BA" 2 #_@list+2#3 > "AB" 2 fi fi
if "_@list+3:" > "ZL" 0 65 ">" $_@list+3#0:24 " " $_@list+3#2:24 " " $_@list+3#3:24 0 if "_@list+3#4:" > "AT" 1 74 30 94 3 0 "C" $_@list+3#4:3 0 fi if "_@list+3#2:" > "BR" 3 34 74 200 94 1 #_@list+3#2 1 1 > "BA" 3 #_@list+3#3 > "AB" 3 fi fi
if "_@list+4:" > "AT" 205 97 237 125 7 0 "C->" 0 fi
//    > "AT" 42 97 111 125 3 0 "Crestart|whole|network" 0

/* > "ZL" 2 105 "Net|work:" 0
> "AT" 42 97 101 125 3 0 "Crestart" 0
> "AT" 105 97 151 125 2 0 "Cstart" 0
> "AT" 155 97 201 125 1 0 "Cstop" 0
*/
//    > "AT" 205 65 237 93 11 0 "CMo|re" 0
    > "AT" 205 33 237 61 10 0 "C<" ifnot "_@_list:0/" "-" fi 0
    > "AT" 205 1 237 29 13 0 "C<" 0
    ];
end

< "button"
    if "_referrer:/*menu.term/" {	//if last page was *menu.term
	switch_n "2";
	boot_cgi [ "show" 0 ] {		//if cgi not found
	    boot_cgi [ "show" ] {
		boot_page "??_back2??";
	    }
	}
	exit_cgi;
    }
    boot_page "??_referrer??";
end

< "B" 1 1 255
	shell "amixer -c ??card?? set '??_@list+1#0??',??_@list+1#1?? ??_nvalue?? >> /dev/tty7";
	boot_cgi [ "show" ];
end
< "B" 2 1 255
	shell "amixer -c ??card?? set '??_@list+2#0??',??_@list+2#1?? ??_nvalue??";
	boot_cgi [ "show" ];
end
< "B" 3 1 255
	shell "amixer -c ??card?? set '??_@list+3#0??',??_@list+3#1?? ??_nvalue??";
	boot_cgi [ "show" ];
end


< "A" 1 3
if "_@list#4:on" {
	shell "amixer -c ??card?? set '??_@list#0??',??_@list#1?? mute";
}
if "_@list#4:off" {
	shell "amixer -c ??card?? set '??_@list#0??',??_@list#1?? unmute";
}
	boot_cgi [ "show" ];
end

//next page
< "A" 7
	set_tbl "list += 3";
	boot_cgi [ "show" ];
end

//page before
< "A" 10
    set_tbl "list == 0"{
    if "_referrer:/*menu.term/" {	//if last page was *menu.term
	switch_n "2";
	boot_cgi [ "show" 0 ] {		//if cgi not found
	    boot_cgi [ "show" ] {
		boot_page "??_back2??";
	    }
	}
	exit_cgi;
    }

	boot_page "??_referrer??";
    }
    set_tbl "list != 0"{
	set_tbl "list -= 3";
	boot_cgi [ "show" ];
    }
end
< "A" 13
    if "_referrer:/*menu.term/" {	//if last page was *menu.term
	switch_n "2";
	boot_cgi [ "show" 0 ] {		//if cgi not found
	    boot_cgi [ "show" ] {
		boot_page "??_back2??";
	    }
	}
	exit_cgi;
    }
    boot_page "??_referrer??";
end
cgi: "show"
